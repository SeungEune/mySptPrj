#### JavaScript 작성 규칙
```javascript
document.addEventListener('DOMContentLoaded', () => {
    fn_init();

    document.getElementById('searchBtn').addEventListener('click', () => fn_searchData(1));
    document.getElementById('searchKeyword').addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            fn_searchData(1);
        }
    });
});

function fn_init() {
    fn_searchData(1);
}

function fn_searchData(pageNo) {
    const searchKeyword = $('#searchKeyword').val();
    const selectBox = $('#selectBox').val();
    const searchType = $('#searchType').val();

    const data = {
        selectBox: Util.isEmpty(selectBox) ? null : selectBox,
        searchVO: {
            searchType: Util.isEmpty(searchType) ? null : searchType,
            searchKeyword: Util.isEmpty(searchKeyword) ? null : searchKeyword,
            pageNo: pageNo
        }
    };

    const callback = function (result) {
        $('#listTbody').empty();

        if (result.list && result.list.length > 0) {
            $('#listTemplate').tmpl(result.list).appendTo('#listTbody');
            setPagination(result.pagingVO, document.getElementById('paginationArea'), 'fn_searchData');
        } else {
            $('#emptyTemplate').tmpl().appendTo('#listTbody');
        }
    };
    callModule.call(Util.getRequestUrl('/module/feature/getList.do'), data, callback, true, 'POST');
}

function fn_goDetailPage(sn) {
    if (Util.isEmpty(sn)) {
        MessageUtil.error('상세 조회 필수 값이 존재하지 않습니다.');
        return;
    }
    const data = { sn: sn };
    callModule.post(Util.getRequestUrl('/module/feature/detail.do'), data, 'GET');
}
```

